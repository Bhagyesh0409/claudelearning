# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.

# ---- Phase 1 ----
# From https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Free static domain from https://dashboard.ngrok.com/domains (no https://). Empty = random URL.
NGROK_DOMAIN=
# Host port for the nginx container
WEB_PORT=8080
# static = bundled JSON (Phase 1) | api = backend at /api (Phase 2+)
VITE_DATA_SOURCE=static

# ---- Phase 2/3 (unused for now) ----
# POSTGRES_USER=portfolio
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=portfolio
# DATABASE_URL=postgres://portfolio:change-me@db:5432/portfolio
